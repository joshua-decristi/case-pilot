# OpenRouter (required for live model runs only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Service auth — required for local runtime (never expose to model context).
# Prefer: make provision-local-auth  (generates random tokens; does not print values)
# Placeholder values below are examples only; do not rely on them in shared .env.
SIMULATOR_SERVICE_TOKEN=
OPERATOR_TOKEN=

# Local service URLs (loopback only)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=8001
BACKEND_BASE_URL=http://127.0.0.1:8000
SIMULATOR_BASE_URL=http://127.0.0.1:8001

# Local data paths (aligned with casepilot.shared.config.Settings defaults)
SIMULATOR_DB_PATH=.data/simulator.sqlite3
BACKEND_DB_PATH=.data/backend.sqlite3
TRACE_DIR=traces
